# Build inputs for the engine image, read by the Dockerfile from the build context.
#
# The pipeline's resolve step OVERWRITES this file in the workspace before building, so the image
# always carries exactly the engine version the tests ran against -- the same file is the single source
# of truth for the build and for the image tags.
#
# Committed empty on purpose: with no values here (and no --build-arg), a plain `docker build` resolves
# the newest Suwayomi release itself and verifies the jar against upstream's published checksum. To
# pin a build, fill these in, or pass --build-arg ENGINE_VERSION=... ENGINE_SHA256=...
ENGINE_VERSION=
ENGINE_SHA256=

# Written by the pipeline as well; used for the image tags (the Dockerfile ignores these two).
ENGINE_SHA=
ENGINE_DATE=
